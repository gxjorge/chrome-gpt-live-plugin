PORT=4317
HOST=127.0.0.1
NODE_ENV=development
# Configure your project and deployment names in the extension's Configuration panel.
# Non-empty values below override saved extension settings, field by field.
# FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# GPT_LIVE_DEPLOYMENT=your-live-deployment
# ASTRA_DEPLOYMENT=your-astra-deployment
# Microsoft-Decision-1 deployment used for fast click targeting (falls back to Astra when unsure):
# DECISION_DEPLOYMENT=your-decision-deployment
# Only when the decision deployment lives in a different Foundry resource than the live/Astra pair:
# DECISION_PROJECT_ENDPOINT=https://your-decision-resource.services.ai.azure.com/api/projects/your-project
DECISION_CONFIDENCE_THRESHOLD=0.7
# Experimental browser policy. Unset keeps the existing managed Astra controller.
# BROWSER_CONTROL=md1-first
# Operator release lock: set true only after an authorized client-delegation smoke check.
MD1_CLIENT_DELEGATION_VERIFIED=false
ASTRA_REASONING_EFFORT=low
GPT_LIVE_VOICE=marin
# Set only for a user-assigned managed identity in Azure:
# AZURE_CLIENT_ID=
